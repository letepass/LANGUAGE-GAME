def savasi_baslat():
    print(SWORD_ART)
    print("⚔️  TELAFFUZ SAVAŞI: ARENAYA HOŞ GELDİNİZ!")
    hero_name = input("Kahramanınızın Adı: ").strip() or "Savaşçı"
    hero = Player(hero_name)
    selected_topic = konu_sec()
    total_score = 0
    correct_words = 0
    wrong_words = 0
    highest_combo = hero.combo

    monsters = [
        Monster("Alev Goblini", hp=40, damage=15, icon="👺"),
        Monster("Buz Golemi", hp=60, damage=18, icon="🗿"),
        Monster("Gölge Şövalye", hp=80, damage=22, icon="🗡️"),
        Monster("Fırtına Ejderhası", hp=100, damage=26, icon="🐲"),
        Monster("Kadim Ejderha", hp=120, damage=30, icon="🐉"),
    ]

    for wave, monster in enumerate(monsters):
        level, level_name = LEVELS[wave]
        topic = selected_topic or random.choice(TOPICS)
        marketi_ac(hero)
        print("\n" + "=" * 50)
        print(f"📈 SEVİYE: {level} - {level_name} | KONU: {topic}")
        print(f"⚠️  KARŞINIZA YENİ BİR RAKİP ÇIKTI: {monster.icon} {monster.name.upper()}!")
        print(MONSTER_ART)
        print("=" * 50)

        words = WORD_BANK[level][topic].copy()
        random.shuffle(words)

        while monster.hp > 0 and hero.hp > 0:
            if not words:
                words = WORD_BANK[level][topic].copy()
                random.shuffle(words)

            expected_en = words.pop()
            try:
                target_tr = translator.translate(expected_en, src="en", dest="tr").text.lower()
            except Exception:
                print("Çeviri servisine ulaşılamadı; bu kelime atlanıyor.")
                continue

            # Durum Çubuğu
            print(f"\n🛡️  {hero.name}: {hero.hp}/{hero.max_hp} HP | 🔥 Combo: x{hero.combo}")
            print(f"👾 {monster.name}: {monster.hp}/{monster.max_hp} HP")
            print(f"👉 TÜRKÇE KELİME: \033[1;33m{target_tr.upper()}\033[0m")

            savasta_envanter_kullan(hero)
            spoken = ses_kaydet_ve_oku(duration=3.5)

            print(f"\n🗣️  Söylenen : {spoken if spoken else '(Büyü Başarısız / Anlaşılamadı)'}")
            print(f"📖 Beklenen : {expected_en}")

            # Saldırı Karşılaştırması
            if spoken and expected_en == spoken.strip(" .,!?:;").lower():
                dmg = hero.attack_power(base_damage=20)
                monster.take_damage(dmg)
                total_score += 100
                correct_words += 1
                hero.combo += 1
                highest_combo = max(highest_combo, hero.combo)
                print("🎯 DOĞRU TELAFFUZ!")
                print(f"⚔️ +{dmg} Hasar")
                print("⭐ +100 Puan")
                print(f"🔥 Combo x{hero.combo}")
            else:
                wrong_words += 1
                actual_damage = hero.take_damage(monster.damage)
                print("❌ TELAFFUZ YANLIŞ!")
                if actual_damage:
                    print(f"💔 -{actual_damage} HP")
                print("⭐ +0 Puan")
                print("🔥 Combo sıfırlandı!")

            time.sleep(1.5)

        if hero.hp <= 0:
            print("\n SAVAŞI KAYBETTİNİZ! Canavar sizi mağlup etti...")
            break
        else:
            hero.gold += 25
            print(f"\n🎉 TEBRİKLER! {monster.name} yok edildi! 25 altın kazandınız.")
            hero.hp = min(hero.max_hp, hero.hp + 25) # Zafer ödülü HP yenileme

    if hero.hp > 0:
        print("\n🏆 ZAFER! Arenadaki tüm canavarları doğru telaffuzlarınızla mağlup ettiniz!")

    total_words = correct_words + wrong_words
    success_rate = round(correct_words / total_words * 100) if total_words else 0
    if success_rate >= 90:
        rank = "EFSANE TELAFFUZCU"
    elif success_rate >= 75:
        rank = "USTA TELAFFUZCU"
    elif success_rate >= 50:
        rank = "GELİŞEN TELAFFUZCU"
    else:
        rank = "ÇAYLAK TELAFFUZCU"

    print("\n🏆 OYUN BİTTİ!")
    print(f"\n⭐ TOPLAM PUAN: {total_score}")
    print(f"🎯 DOĞRU KELİMELER: {correct_words}")
    print(f"❌ YANLIŞ KELİMELER: {wrong_words}")
    print(f"🔥 EN YÜKSEK COMBO: x{highest_combo}")
    print(f"\n📊 BAŞARI ORANI: %{success_rate}")
    print(f"\n🥇 RÜTBE: {rank}")

if __name__ == "__main__":
    savasi_baslat()