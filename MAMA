class Player:
    def __init__(self, name="Kahraman"):
        self.name = name
        self.hp = 100
        self.max_hp = 100
        self.combo = 1
        self.gold = 30
        self.inventory = {"potion": 0, "shield": 0}

    def attack_power(self, base_damage=15):
        return base_damage * self.combo

    def take_damage(self, damage):
        self.combo = 1
        if self.inventory["shield"] > 0:
            self.inventory["shield"] -= 1
            print("🛡️ Telaffuz Kalkanı saldırıyı engelledi!")
            return 0
        actual_damage = min(damage, self.hp)
        self.hp -= actual_damage
        return actual_damage


