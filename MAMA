recognizer = sr.Recognizer()
translator = Translator()

def ses_kaydet_ve_oku(duration=3, sample_rate=44100):
    print("\n🔴 SALDIRI İÇİN KONUŞUN! (Dinleniyor...)")
    recording = sd.rec(int(duration * sample_rate), samplerate=sample_rate, channels=1, dtype="int16")
    sd.wait()
    wav.write("battle_temp.wav", sample_rate, recording)

    try:
        with sr.AudioFile("battle_temp.wav") as source:
            audio = recognizer.record(source)
            text = recognizer.recognize_google(audio, language="en-US").lower()
            return text
    except sr.UnknownValueError:
        return None
    except Exception:
        return None
    finally:
        if os.path.exists("battle_temp.wav"):
            os.remove("battle_temp.wav")


