def konu_sec():
    print("\n📚 KONU KATEGORİSİ SEÇİN")
    for index, topic in enumerate(TOPICS, start=1):
        print(f"{index}. {topic}")
    print("0. Her seviyede rastgele konu")

    while True:
        choice = input("Seçiminiz: ").strip()
        if choice == "0":
            return None
        if choice.isdigit() and 1 <= int(choice) <= len(TOPICS):
            return TOPICS[int(choice) - 1]
        print("Geçerli bir kategori numarası girin.")


def envanteri_goster(hero):
    print("\n🎒 ENVANTER")
    print(f"Can İksiri 🧪: {hero.inventory['potion']}")
    print(f"Telaffuz Kalkanı 🛡️: {hero.inventory['shield']}")


def marketi_ac(hero):
    while True:
        print(f"\n🛒 MARKET | Altın: {hero.gold}")
        print("1. Can İksiri 🧪 (20 altın) - 40 HP yeniler")
        print("2. Telaffuz Kalkanı 🛡️ (35 altın) - bir canavar saldırısını engeller")
        print("E. Envanteri göster")
        print("0. Arenaya devam et")
        choice = input("Seçiminiz: ").strip().lower()

        if choice == "0":
            return
        if choice == "e":
            envanteri_goster(hero)
            continue
        if choice not in ITEMS:
            print("Geçersiz seçim.")
            continue

        item_key, item_name, price = ITEMS[choice]
        if hero.gold < price:
            print("Yeterli altınınız yok.")
            continue
        hero.gold -= price
        hero.inventory[item_key] += 1
        print(f"{item_name} satın alındı!")


def savasta_envanter_kullan(hero):
    while True:
        action = input("► ENTER: konuş | I: iksir | E: envanter: ").strip().lower()
        if action == "i":
            if hero.inventory["potion"] == 0:
                print("Envanterinizde Can İksiri yok.")
            elif hero.hp == hero.max_hp:
                print("Canınız zaten tamamen dolu.")
            else:
                hero.inventory["potion"] -= 1
                healed = min(40, hero.max_hp - hero.hp)
                hero.hp += healed
                print(f"🧪 İksir kullanıldı: +{healed} HP ({hero.hp}/{hero.max_hp}).")
            continue
        if action == "e":
            envanteri_goster(hero)
            continue
        if action == "":
            return
        print("Geçersiz seçim. Devam etmek için ENTER'a basın.")


class Monster:
    def __init__(self, name, hp, damage, icon="👾"):
        self.name = name
        self.hp = hp
        self.max_hp = hp
        self.damage = damage
        self.icon = icon

    def take_damage(self, damage):
        self.hp = max(0, self.hp - damage)


